# Shared room state for Vercel production. Prefer installing Upstash Redis
# from Vercel Marketplace so these values are injected into the project.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint
UPSTASH_REDIS_REST_TOKEN=your-server-side-token

# Supported alternate names for existing Vercel KV/Upstash integrations:
# KV_REST_API_URL=https://your-upstash-redis-endpoint
# KV_REST_API_TOKEN=your-server-side-token
